APP_NAME=CETIX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cetix
DB_USERNAME=cetix
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

AUDIT_DB_HOST=postgres
AUDIT_DB_PORT=5432
AUDIT_DB_DATABASE=cetix
AUDIT_DB_USERNAME=cetix_maintenance
AUDIT_DB_PASSWORD=
